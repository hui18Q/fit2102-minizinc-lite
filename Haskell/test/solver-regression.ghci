-- Part C file contents (formatSolution is pure, so no file is written).
saveFormatTests :: [(String, Bool)]
saveFormatTests =
    [ ( "Spec p.12 example file contents"
      , formatSolution "2026-09-18T06-05-58" [("x", 1), ("y", 2)]
            == "-- Generated: 2026-09-18T06-05-58\n\nx = 1;\ny = 2;\n" )
    , ( "Array elements and negative values"
      , formatSolution "T" [("q[1]", 2), ("q[2]", -3)]
            == "-- Generated: T\n\nq[1] = 2;\nq[2] = -3;\n" )
    , ( "Saving a solved model"
      , fmap (fmap (formatSolution "T")) (solveText "var 1..3: x; constraint x > 2; solve satisfy;")
            == Just (Just "-- Generated: T\n\nx = 3;\n") )
    ]
:}

saveFormatResults <- section "SAVE FILE FORMAT (PART C)" saveFormatTests

:{
-- Part E bounds reasoning. Pruning must only remove branches with no
-- solution, so every answer below is the same as without bounds; the
-- first two models were too slow to finish before (38.7s and >120s).
boundsTests :: [(String, Bool)]
boundsTests =
    [ ( "Spec p.15 sum example is pruned (no solution)"
      , solveText "int: n = 8; array[1..n] of var 1..n: q; constraint sum(i in 1..n)(q[i] + i) = 42; solve satisfy;"
            == Just Nothing )
    , ( "Large satisfiable sum is found"
      , fmap (fmap (sum . map snd)) (solveText "array[1..9] of var 0..9: q; constraint sum(q) = 79; solve satisfy;")
            == Just (Just 79) )
    , ( "Reachable target is not pruned"
      , solveText "var 1..10: x; var 1..10: y; constraint x + y = 5; solve satisfy;"
            == Just (Just [("x", 1), ("y", 4)]) )
    , ( "Divisor that may be 0 is not used for pruning"
      , solveText "var -1..1: d; var 1..3: x; constraint 6 / d = x * 2; solve satisfy;"
            == Just (Just [("d", 1), ("x", 3)]) )
    , ( "Optimisation keeps the optimum"
      , solveText "array[1..4] of var 0..5: q; constraint sum(q) <= 7; solve maximize q[1] * 2 + q[2];"
            == Just (Just [("q[1]", 5), ("q[2]", 2), ("q[3]", 0), ("q[4]", 0)]) )
    , ( "Negation flips the interval"
      , solveText "var -5..5: a; var -5..5: b; constraint -a - b = 10; solve satisfy;"
            == Just (Just [("a", -5), ("b", -5)]) )
    , ( "x = 8 makes x + y = 5 impossible (y in 1..10)"
      , impossible [] [("x", Interval 1 10), ("y", Interval 1 10)] [("x", 8)]
            (Compare OpEq (Add (Var "x") (Var "y")) (IntLit 5)) )
    , ( "x = 3 keeps x + y = 5 possible"
      , not (impossible [] [("x", Interval 1 10), ("y", Interval 1 10)] [("x", 3)]
            (Compare OpEq (Add (Var "x") (Var "y")) (IntLit 5))) )
    -- 2^62 * 4 wraps to 0 in a 64-bit Int, so the evaluator accepts
    -- x = 1. Bounds outside the Int range must not prune that solution.
    , ( "No pruning when a value may overflow Int"
      , solveText "var 1..1: x; var 0..0: y; constraint x * 4611686018427387904 * 4 + y = 0; solve satisfy;"
            == Just (Just [("x", 1), ("y", 0)]) )
    , ( "No bounds through a divisor interval containing 0"
      , not (impossible [] [("d", Interval (-1) 1)] []
            (Compare OpEq (Div (IntLit 6) (Var "d")) (IntLit 100))) )
    ]
:}

boundsResults <- section "BOUNDS REASONING (PART E)" boundsTests

:{
-- Part E mod and abs. mod is Haskell's mod (rounds down, so the result
-- has the sign of the divisor), matching / which also rounds down.
modAbsTests :: [(String, Bool)]
modAbsTests =
    [ ( "7 mod 3 = 1"
      , solveText "var 0..9: x; constraint x = 7 mod 3; solve satisfy;" == Just (Just [("x", 1)]) )
    , ( "-7 mod 3 = 2 (sign of the divisor)"
      , solveText "var -5..5: x; constraint x = -7 mod 3; solve satisfy;" == Just (Just [("x", 2)]) )
    , ( "7 mod -3 = -2"
      , solveText "var -5..5: x; constraint x = 7 mod -3; solve satisfy;" == Just (Just [("x", -2)]) )
    , ( "abs of negative, zero and nested values"
      , solveText "var 0..9: x; var 0..9: y; var 0..9: z; constraint x = abs(-5); constraint y = abs(0); constraint z = abs(abs(-3)); solve satisfy;"
            == Just (Just [("x", 5), ("y", 0), ("z", 3)]) )
    , ( "1 + 8 mod 3 = 3 (precedence)"
      , solveText "var 0..9: x; constraint x = 1 + 8 mod 3; solve satisfy;" == Just (Just [("x", 3)]) )
    , ( "mod by zero invalidates only that assignment"
      , solveText "var 0..2: d; constraint 5 mod d = 1; solve satisfy;" == Just (Just [("d", 2)]) )
    , ( "maximize x with x mod 3 = 1"
      , solveText "var 0..9: x; constraint x mod 3 = 1; solve maximize x;" == Just (Just [("x", 7)]) )
    , ( "minimize x with abs(x) = 3"
      , solveText "var -5..5: x; constraint abs(x) = 3; solve minimize x;" == Just (Just [("x", -3)]) )
    , ( "maximize x with abs(x - 3) = 2"
      , solveText "var 0..9: x; constraint abs(x - 3) = 2; solve maximize x;" == Just (Just [("x", 5)]) )
    , ( "mod and abs with arrays, generators and the objective"
      , solveText "array[1..3] of var 1..6: q; constraint all(i in 1..3)(q[i] mod 2 = 0); constraint allDifferent(q); solve minimize sum(i in 1..3)(abs(q[i] - 4));"
            == Just (Just [("q[1]", 2), ("q[2]", 4), ("q[3]", 6)]) )
    , ( "mod in the objective (first maximum is kept)"
      , solveText "var 0..9: x; solve maximize x mod 5;" == Just (Just [("x", 4)]) )
    -- Without bounds for mod and abs these would try 10^8 and 11^8
    -- assignments; each item's interval proves the sums unreachable.
    , ( "Bounds: sum of q[i] mod 3 cannot reach 17"
      , solveText "array[1..8] of var 0..9: q; constraint sum(i in 1..8)(q[i] mod 3) = 17; solve satisfy;"
            == Just Nothing )
    , ( "Bounds: sum of abs(q[i]) cannot reach 41"
      , solveText "array[1..8] of var -5..5: q; constraint sum(i in 1..8)(abs(q[i])) = 41; solve satisfy;"
            == Just Nothing )
    , ( "mod by a known 0 is Invalid even with an unknown dividend"
      , evalPartial [] [("d", 0)] (Mod (Var "x") (Var "d")) == Invalid )
    -- The cases below assume a 64-bit Int (minBound = -2^63), as on
    -- the GHC used for this assignment.
    , ( "abs of minBound gives no bounds (would overflow Int)"
      , boundsOf [] [("x", Interval (toInteger (minBound :: Int)) (toInteger (minBound :: Int)))] [] (Abs (Var "x"))
            == Nothing )
    -- minBound `div` (-1) does not fit in Int; it must be an invalid
    -- assignment, not an arithmetic overflow crash.
    , ( "minBound / -1 is invalid, not a crash"
      , solveText "var -1..-1: d; var 0..1: x; constraint (0 - 9223372036854775807 - 1) / d = x; solve satisfy;"
            == Just Nothing )
    , ( "minBound / d skips only the overflowing divisor"
      , solveText "var -1..1: d; var -1..1: x; constraint (0 - 9223372036854775807 - 1) / d = x * 0 + (0 - 9223372036854775807 - 1); solve satisfy;"
            == Just (Just [("d", 1), ("x", -1)]) )
    ]
:}

modAbsResults <- section "MOD AND ABS (PART E)" modAbsTests

-- The provided N-Queens example, read from the real input file and
-- checked against every accepted answer in the expected output.
nqueensSource <- readFile "examples/inputs/nqueens.mzn"
nqueensAccepted <- map (sort . read) . filter (not . null) . lines <$> readFile "examples/expected_output/nqueens.out" :: IO [[(String, Int)]]
nqueensResults <- section "NQUEENS (examples/inputs/nqueens.mzn)" [("Optimal solution is an accepted answer", fmap (fmap sort) (solveText nqueensSource) `elem` map (Just . Just) nqueensAccepted)]

let results = searchResults ++ optimisationResults ++ edgeResults ++ endToEndResults ++ arrayResults ++ validationResults ++ saveFormatResults ++ boundsResults ++ modAbsResults ++ nqueensResults
putStrLn ("RESULT: " ++ show (length (filter id results)) ++ "/" ++ show (length results) ++ " tests passed")
