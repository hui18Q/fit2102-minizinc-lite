-- Parser regression tests (Generated by Chatgpt and reviewed by student) for MiniZinc-Lite.
-- Run from Haskell/:  stack ghci  then  :script test/parser-regression.ghci
:module + *MiniZincParser Instances MiniZincADT

:{
-- A program is accepted only if it parses with no input left over.
accepts :: String -> Bool
accepts source = case parse miniZincParser source of
    Result "" _ -> True
    _ -> False

-- The complement of accepts.
rejects :: String -> Bool
rejects = not . accepts

-- A program parses to exactly the expected AST.
parsesTo :: ADT -> String -> Bool
parsesTo expected source = case parse miniZincParser source of
    Result "" adt -> adt == expected
    _ -> False

-- Prints the outcome of one named test and returns it.
check :: (String, Bool) -> IO Bool
check (name, ok) = do
    putStrLn ((if ok then "PASS: " else "FAIL: ") ++ name)
    pure ok

-- Wraps a constraint list and goal around declarations of x and y.
xy :: [Constraint] -> SolverGoal -> ADT
xy = ADT [VariableDeclaration "x" (Range 1 3), VariableDeclaration "y" (Range 1 3)]
:}

:{
validTests :: [(String, Bool)]
validTests =
    [ ("Basic solve", accepts "solve satisfy;")
    , ("Variable", accepts "var 1..5: x; solve satisfy;")
    , ("Negative range bound", accepts "int: m = 3; var -m..10: x; solve satisfy;")
    , ("Finite set", accepts "var { -1 , 2 }: x; solve satisfy;")
    , ("Comparison operators", accepts "var 1..3: x; constraint x != 1; constraint x <= 3; constraint x >= 1; constraint x < 4; constraint x > 0; constraint x = 2; solve satisfy;")
    , ("Numeric macros", accepts "var 1..5: x; constraint sum([x, 1]) = 3; constraint min([x, 2]) >= 1; constraint max([x]) <= 5; solve satisfy;")
    , ("Boolean macros", accepts "var 1..5: x; constraint all([x > 1, x < 5]); constraint any([x = 1, x = 2]); constraint allDifferent([x, 1]); solve satisfy;")
    , ("Identifier containing keyword", accepts "var 1..3: summary; var 1..3: minimum; solve maximize summary;")
    , ("Whitespace and newlines", accepts "  \n var 1..3: x;\n\t constraint x > 1;\n solve satisfy;  \n")
    , ("Spec example model", parsesTo (ADT [VariableDeclaration "x" (Range 1 3)] [Compare OpEq (Var "x") (IntLit 2)] Satisfy) "var 1..3: x; constraint x = 2; solve satisfy;")
    , ("Constant kept as AST, domain resolved", parsesTo (ADT [ConstantDeclaration "n" (IntLit 3), ConstantDeclaration "m" (Add (Var "n") (IntLit 2)), VariableDeclaration "x" (Range 1 5)] [] (Maximize (Var "x"))) "int: n = 3; int: m = n + 2; var 1..m: x; solve maximize x;")
    , ("Interleaved statements keep order", parsesTo (xy [Compare OpGt (Var "x") (IntLit 1), Compare OpGt (Var "y") (Var "x")] Satisfy) "var 1..3: x; constraint x > 1; var 1..3: y; constraint y > x; solve satisfy;")
    , ("Precedence: + below *", parsesTo (xy [] (Minimize (Add (Var "x") (Mul (Var "y") (IntLit 2))))) "var 1..3: x; var 1..3: y; solve minimize x + y * 2;")
    , ("Precedence: -x^2 is -(x^2)", parsesTo (xy [] (Minimize (Neg (Pow (Var "x") (IntLit 2))))) "var 1..3: x; var 1..3: y; solve minimize -x^2;")
    , ("Associativity: ^ is right", parsesTo (xy [] (Minimize (Pow (Var "x") (Pow (Var "y") (IntLit 2))))) "var 1..3: x; var 1..3: y; solve minimize x^y^2;")
    , ("Associativity: - is left", parsesTo (xy [] (Minimize (Sub (Sub (Var "x") (Var "y")) (IntLit 1)))) "var 1..3: x; var 1..3: y; solve minimize x - y - 1;")
    , ("Parentheses", parsesTo (xy [] (Minimize (Mul (Add (Var "x") (Var "y")) (IntLit 2)))) "var 1..3: x; var 1..3: y; solve minimize (x + y) * 2;")
    , ("Array declaration", parsesTo (ADT [ArrayDeclaration "q" 3 (Range 1 5)] [] Satisfy) "array[1..3] of var 1..5: q; solve satisfy;")
    , ("Array length and domain from a constant", parsesTo (ADT [ConstantDeclaration "n" (IntLit 3), ArrayDeclaration "q" 3 (Range 1 3)] [] Satisfy) "int: n = 3; array[1..n] of var 1..n: q; solve satisfy;")
    , ("Spec array example", parsesTo (ADT [ArrayDeclaration "list" 5 (Range (-3) 6)] [] Satisfy) "array[1..5] of var -3..6: list; solve satisfy;")
    , ("Array with spaces and a finite set", accepts "array [ 1 .. 2 ] of var {1, 3}: q ; solve satisfy;")
    , ("Array of length 1", accepts "array[1..1] of var 1..2: q; solve satisfy;")
    , ("Array access in a constraint", parsesTo (ADT [ArrayDeclaration "q" 3 (Range 1 5)] [Compare OpEq (ArrayAccess "q" (IntLit 1)) (IntLit 2)] Satisfy) "array[1..3] of var 1..5: q; constraint q[1] = 2; solve satisfy;")
    , ("Array access in an expression", accepts "array[1..3] of var 1..5: q; constraint q[1] + q[2] = 5; solve satisfy;")
    , ("Array access in the objective", parsesTo (ADT [ArrayDeclaration "q" 3 (Range 1 5)] [] (Minimize (ArrayAccess "q" (IntLit 1)))) "array[1..3] of var 1..5: q; solve minimize q[1];")
    , ("Array index from a constant expression", accepts "int: n = 2; array[1..3] of var 1..5: q; constraint q[n] = q[n+1]; solve satisfy;")
    , ("Out-of-bounds literal index parses (invalid at solve time)", accepts "array[1..3] of var 1..5: q; constraint q[5] = 2; solve satisfy;")
    ]
:}

:{
invalidTests :: [(String, Bool)]
invalidTests =
    [ ("Empty input", rejects "")
    , ("Missing solve", rejects "var 1..5: x;")
    , ("Missing semicolon", rejects "var 1..5: x solve satisfy;")
    , ("== is not an operator", rejects "var 1..3: x; constraint x == 1; solve satisfy;")
    , ("Duplicate variables", rejects "var 1..3: x; var 1..5: x; solve satisfy;")
    , ("Duplicate constant/variable", rejects "int: x = 3; var 1..5: x; solve satisfy;")
    , ("Keyword as identifier", rejects "var 1..3: var; solve satisfy;")
    , ("Undeclared in constraint", rejects "constraint x = 3; solve satisfy;")
    , ("Undeclared in solve goal", rejects "solve maximize x;")
    , ("Undeclared in macro", rejects "var 1..3: x; constraint all([x = 1, z = 2]); solve satisfy;")
    , ("Use before declaration", rejects "constraint x > 1; var 1..3: x; solve satisfy;")
    , ("Undeclared constant", rejects "int: a = b + 1; solve satisfy;")
    , ("Constant uses a variable", rejects "var 1..3: x; int: a = x + 1; solve satisfy;")
    , ("Constant divides by zero", rejects "int: a = 5 / 0; solve satisfy;")
    , ("Range bound declared later", rejects "var 1..n: x; int: n = 3; solve satisfy;")
    , ("Reversed range", rejects "var 5..1: x; solve satisfy;")
    , ("Duplicate set values", rejects "var {1, 2, 1}: x; solve satisfy;")
    , ("Numeric macro without comparison", rejects "var 1..3: x; constraint sum([x]); solve satisfy;")
    , ("Macro without brackets", rejects "var 1..3: x; constraint sum(x, 1) = 2; solve satisfy;")
    , ("Empty macro list", rejects "var 1..3: x; constraint allDifferent([]); solve satisfy;")
    , ("Trailing comma", rejects "var 1..3: x; constraint sum([x,]) = 2; solve satisfy;")
    , ("Two solve directives", rejects "solve satisfy; solve satisfy;")
    , ("Code after solve", rejects "solve satisfy; garbage")
    , ("Array lower bound 0", rejects "array[0..3] of var 1..5: q; solve satisfy;")
    , ("Array lower bound 2", rejects "array[2..3] of var 1..5: q; solve satisfy;")
    , ("Array length 0", rejects "array[1..0] of var 1..5: q; solve satisfy;")
    , ("Array length 0 from a constant", rejects "int: n = 0; array[1..n] of var 1..5: q; solve satisfy;")
    , ("Array length from undeclared constant", rejects "array[1..n] of var 1..5: q; solve satisfy;")
    , ("Array name already declared", rejects "var 1..3: q; array[1..3] of var 1..5: q; solve satisfy;")
    , ("Name already used by an array", rejects "array[1..3] of var 1..5: q; var 1..3: q; solve satisfy;")
    , ("Array element domain reversed", rejects "array[1..3] of var 5..1: q; solve satisfy;")
    , ("Array missing of", rejects "array[1..3] var 1..5: q; solve satisfy;")
    , ("Array negative length", rejects "array[1..-2] of var 1..5: q; solve satisfy;")
    , ("Array missing var", rejects "array[1..3] of 1..5: q; solve satisfy;")
    , ("Array lower bound from a constant (must be literal 1)", rejects "int: a = 1; array[a..3] of var 1..5: q; solve satisfy;")
    , ("Duplicate array declarations", rejects "array[1..3] of var 1..5: q; array[1..2] of var 1..5: q; solve satisfy;")
    , ("Array used as a scalar", rejects "array[1..3] of var 1..5: q; constraint q = 2; solve satisfy;")
    , ("Scalar indexed as an array", rejects "var 1..5: x; constraint x[1] = 2; solve satisfy;")
    , ("Undeclared array access", rejects "constraint q[1] = 2; solve satisfy;")
    , ("Array mixed scalar and indexed use", rejects "array[1..3] of var 1..5: q; constraint q + q[1] = 5; solve satisfy;")
    , ("Undeclared name inside an index", rejects "array[1..3] of var 1..5: q; constraint q[y] = 2; solve satisfy;")
    ]
:}

putStrLn "=== VALID PROGRAMS ==="
validResults <- mapM check validTests
putStrLn "=== INVALID PROGRAMS ==="
invalidResults <- mapM check invalidTests
let results = validResults ++ invalidResults
putStrLn ("RESULT: " ++ show (length (filter id results)) ++ "/" ++ show (length results) ++ " tests passed")

